{
  "name": "a2ui-warm-paper",
  "version": "1.0.0",
  "description": "Experimental A2UI-inspired React component system with Nymrel's Warm Paper design aesthetic",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles/warm-paper.css": {
      "types": "./dist/styles/warm-paper.css.d.ts",
      "default": "./dist/styles/warm-paper.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "check": "npm test && npm run typecheck && npm run verify:consumer",
    "prepublishOnly": "npm run check",
    "test": "npm run build && node test/run-tests.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm test && npm run typecheck",
    "verify:consumer": "node scripts/verify-packed-consumer.mjs"
  },
  "keywords": [
    "a2ui",
    "agent-to-ui",
    "generative-ui",
    "react",
    "typescript",
    "nymrel",
    "warm-paper",
    "design-system",
    "ai-agents",
    "human-in-the-loop"
  ],
  "author": "Nymrel <contact@nymrel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nymrel/a2ui-warm-paper"
  },
  "homepage": "https://github.com/nymrel/a2ui-warm-paper#readme",
  "bugs": {
    "url": "https://github.com/nymrel/a2ui-warm-paper/issues"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10.9.0 <12"
  },
  "packageManager": "npm@11.19.1",
  "publishConfig": {
    "access": "public"
  }
}
