{
  "name": "a2ui-warm-paper",
  "version": "1.0.0",
  "description": "Experimental A2UI-inspired React component system with Nymrel's Warm Paper design aesthetic",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles/warm-paper.css": "./dist/styles/warm-paper.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node test/run-tests.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm test && npm run typecheck"
  },
  "keywords": [
    "a2ui",
    "agent-to-ui",
    "generative-ui",
    "react",
    "typescript",
    "nymrel",
    "warm-paper",
    "design-system",
    "ai-agents",
    "human-in-the-loop"
  ],
  "author": "Nymrel <contact@nymrel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nymrel/a2ui-warm-paper"
  },
  "homepage": "https://github.com/nymrel/a2ui-warm-paper#readme",
  "bugs": {
    "url": "https://github.com/nymrel/a2ui-warm-paper/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
